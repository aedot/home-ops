---
machine:
  ca:
    crt: bws://MACHINE_CA_CRT
    key: bws://MACHINE_CA_KEY
cluster:
  ca:
    crt: bws://CLUSTER_CA_CRT
    key: bws://CLUSTER_CA_KEY
  aggregatorCA:
    crt: bws://CLUSTER_AGGREGATORCA_CRT
    key: bws://CLUSTER_AGGREGATORCA_KEY
  serviceAccount:
    key: bws://CLUSTER_SERVICEACCOUNT_KEY
  # Kept classic: Talos expands this into the apiserver EncryptionConfig with a
  # fixed key name/order. Rewriting it as KubeEtcdEncryptionConfig risks changing
  # that and making already-encrypted secrets unreadable.
  secretboxEncryptionSecret: bws://CLUSTER_SECRETBOXENCRYPTIONSECRET
  etcd:
    ca:
      crt: bws://CLUSTER_ETCD_CA_CRT
      key: bws://CLUSTER_ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
    advertisedSubnets:
      - 172.24.20.0/24
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:{{ kubernetesVersion }}
certExtraSANs:
  - 127.0.0.1
  - 172.24.20.11
extraArgs:
  # https://kubernetes.io/docs/tasks/extend-kubernetes/configure-aggregation-layer/
  enable-aggregator-routing: "true"
  feature-gates: HPAScaleToZero=true
---
# PodSecurity set to privileged everywhere = no PSA restrictions (Longhorn etc.
# run privileged). Exemptions inherited from the generated base (kube-system).
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1alpha1
  kind: PodSecurityConfiguration
  defaults:
    audit: privileged
    audit-version: latest
    enforce: privileged
    enforce-version: latest
    warn: privileged
    warn-version: latest
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:{{ kubernetesVersion }}
extraArgs:
  bind-address: 0.0.0.0
  feature-gates: HPAScaleToZero=true
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:{{ kubernetesVersion }}
extraArgs:
  bind-address: 0.0.0.0
config:
  apiVersion: kubescheduler.config.k8s.io/v1
  kind: KubeSchedulerConfiguration
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
---
# CoreDNS is deployed via GitOps, not Talos-managed.
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
---
# Cilium is the kube-proxy replacement.
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false

---
machine:
  type: controlplane
  network:
    hostname: oba
    interfaces:
      - interface: bond0
        bond:
          deviceSelectors:
            - hardwareAddr: "58:47:ca:7b:ea:1c"
          mode: active-backup
        dhcp: true
        vip:
          ip: 172.24.20.11
        vlans:
          - vlanId: 40   # IoT VLAN
            dhcp: false
            mtu: 1500
          - vlanId: 50   # Vpn VLAN
            dhcp: false
            mtu: 1500
  install:
    diskSelector:
      serial: AA230711NV01KG10664
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    match: disk.serial == "50026B7383951A37"
  minSize: 300GiB
  grow: true
